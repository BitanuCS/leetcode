   "id": "515d4335",
   "metadata": {},
   "outputs": [],
   "source": [
    "hashmap = {}\n",
    "for num in nums:\n",
    "    while num != 0:\n",
    "        rem = num % 10\n",
    "        hashmap[rem] = hashmap.get(rem, 0) + 1\n",
    "        num = num // 10"
   ]
  },
